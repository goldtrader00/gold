//@version=6
// Generated by gld_levels.py at 2026-10-21 22:06 (UTC+7), gold spot 4128.90.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1792595180472
genSpot = 4128.90

plot(showLevels ? 4145.77 : na, "New CALL 4146", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4091.22 : na, "New PUT 4091", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4138.84 : na, "Gamma Flip 4139", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4142.77 : na, "VWAP week 4143", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4155.07 : na, "VWAP month 4155", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4140.74 : na, "Week POC 4141", color=#ffa94d, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4140.74 : na, "Month POC 4141", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4155.07, "VWAP month  4,155.07", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#4fe0d0, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4145.77, "New CALL  4,145.77  #2  C 17.3K / P 18.0K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4138.84, "Gamma Flip + Month POC + Week POC + VWAP week  4,138.84", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4091.22, "New PUT  4,091.22  #3  C 8.3K / P 10.1K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-21 22:06 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
