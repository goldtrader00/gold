//@version=6
// Generated by gld_levels.py at 2026-11-04 21:09 (UTC+7), gold spot 4044.40.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793801396952
genSpot = 4044.40

plot(showLevels ? 4093.99 : na, "New CALL 4094", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4089.39 : na, "Funds buy (est.) 4089", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4039.40 : na, "New CALL 4039", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4028.49 : na, "New CALL 4028", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3984.82 : na, "New CALL 3985", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 3990.14 : na, "Gamma Flip 3990", color=#b79bff, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4093.99, "New CALL + Funds buy (est.)  4,093.99  #3  C 18.2K / P 14.6K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4039.40, "New CALL  4,039.40  #2  C 15.6K / P 20.8K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4028.49, "New CALL  4,028.49  #6  C 3.6K / P 6.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3984.82, "New CALL + Gamma Flip  3,984.82  #4  C 11.6K / P 19.5K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-04 21:09 (UTC+7)" + ("\nUsing an older saved ratio (the GLD quote is stale): strike levels can be off by $10-20. Run again during US hours (after 20:50 your time). VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
