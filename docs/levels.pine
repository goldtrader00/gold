//@version=6
// Generated by gld_levels.py at 2026-11-10 00:40 (UTC+7), gold spot 4106.30.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1794246004189
genSpot = 4106.30

plot(showLevels ? 4149.22 : na, "Call Wall + New CALL 4149", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4099.03 : na, "Funds buy (est.) 4099", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4094.62 : na, "New CALL 4095", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4149.22 : na, "Max Pain 4149", color=#f5c542, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4112.52 : na, "VWAP week 4113", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4047.80 : na, "VWAP month 4048", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4123.71 : na, "Week POC 4124", color=#ffa94d, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4077.71 : na, "Month POC 4078", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4149.22, "Call Wall + New CALL + Max Pain  4,149.22  #1  C 46.1K / P 31.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4123.71, "Week POC  4,123.71", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4112.52, "VWAP week  4,112.52", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#6fd0ff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4094.62, "New CALL + Funds buy (est.)  4,094.62  #5  C 19.3K / P 14.7K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4077.71, "Month POC  4,077.71", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4047.80, "VWAP month  4,047.80", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#4fe0d0, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-10 00:40 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
