//@version=6
// Generated by gld_levels.py at 2026-11-11 21:12 (UTC+7), gold spot 4030.60.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1794406375213
genSpot = 4030.60

plot(showLevels ? 4072.34 : na, "New CALL 4072", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4039.59 : na, "New CALL + New PUT 4040", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4028.67 : na, "New CALL 4029", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3985.00 : na, "New PUT 3985", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4042.49 : na, "Gamma Flip 4042", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4088.11 : na, "VWAP week 4088", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4048.11 : na, "VWAP month 4048", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4073.41 : na, "Month POC 4073", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4088.11, "VWAP week  4,088.11", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#6fd0ff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4072.34, "New CALL + Month POC  4,072.34  #8  C 5.4K / P 1.8K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4048.11, "VWAP month  4,048.11", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#4fe0d0, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4039.59, "New PUT + New CALL + Gamma Flip  4,039.59  #2  C 12.3K / P 30.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4028.67, "New CALL  4,028.67  #7  C 1.6K / P 7.4K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3985.00, "New PUT  3,985.00  #6  C 7.0K / P 17.7K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-11 21:12 (UTC+7)" + ("\nUsing an older saved ratio (the GLD quote is stale): strike levels can be off by $10-20. Run again during US hours (after 20:50 your time). VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
