//@version=6
// Generated by gld_levels.py at 2026-10-28 22:47 (UTC+7), gold spot 4044.70.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793202476677
genSpot = 4044.70

plot(showLevels ? 4084.24 : na, "Funds buy (est.) 4084", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4043.02 : na, "New CALL 4043", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4032.32 : na, "Funds buy (est.) 4032", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4094.46 : na, "Gamma Flip 4094", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4036.55 : na, "VWAP week 4037", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4028.92 : na, "Week POC 4029", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4094.46, "Gamma Flip  4,094.46", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4084.24, "Funds buy (est.)  4,084.24", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff9ec7, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4043.02, "New CALL  4,043.02  #4  C 5.4K / P 12.1K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4036.55, "VWAP week  4,036.55", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#6fd0ff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4028.92, "Week POC + Funds buy (est.)  4,028.92", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-28 22:47 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
