//@version=6
// Generated by gld_levels.py at 2026-10-20 02:34 (UTC+7), gold spot 4145.20.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1792438494047
genSpot = 4145.20

plot(showLevels ? 4202.09 : na, "New CALL 4202", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4147.51 : na, "New PUT 4148", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4092.94 : na, "New CALL + New PUT 4093", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4157.54 : na, "Gamma Flip 4158", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4136.60 : na, "Max Pain 4137", color=#f5c542, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4163.11 : na, "VWAP W + M 4163", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4169.94 : na, "Week POC 4170", color=#ffa94d, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4146.94 : na, "Month POC 4147", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4202.09, "New CALL  4,202.09  #5  C 8.8K / P 3.4K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4169.94, "Week POC  4,169.94", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4157.54, "Gamma Flip + VWAP W + M  4,157.54", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4147.51, "New PUT + Month POC  4,147.51  #2  C 14.8K / P 18.1K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4136.60, "Max Pain  4,136.60", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#f5c542, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4092.94, "New PUT + New CALL  4,092.94  #3  C 8.4K / P 10.8K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-20 02:34 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
