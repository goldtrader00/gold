//@version=6
// Generated by gld_levels.py at 2026-10-19 19:26 (UTC+7), gold spot 4166.10.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1792412770694
genSpot = 4166.10

plot(showLevels ? 4188.80 : na, "New CALL 4189", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4134.40 : na, "New PUT 4134", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4145.96 : na, "Gamma Flip 4146", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4123.52 : na, "Max Pain 4124", color=#f5c542, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4174.54 : na, "VWAP week 4175", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4166.15 : na, "VWAP month 4166", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4172.80 : na, "Week POC 4173", color=#ffa94d, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4193.80 : na, "Month POC 4194", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4188.80, "New CALL + Month POC  4,188.80  #6  C 8.8K / P 3.4K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4172.80, "VWAP week + Week POC  4,172.80", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4166.15, "VWAP month  4,166.15", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#4fe0d0, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4145.96, "Gamma Flip  4,145.96", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4134.40, "New PUT  4,134.40  #2  C 14.8K / P 18.1K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4123.52, "Max Pain  4,123.52", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#f5c542, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-19 19:26 (UTC+7)" + ("\nNo fresh price ratio yet: strike levels (ceilings, floors, flip, max pain) can be off by $10-50. Run again during US hours (after 20:50 your time). VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
