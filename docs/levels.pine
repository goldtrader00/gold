//@version=6
// Generated by gld_levels.py at 2026-11-06 22:51 (UTC+7), gold spot 4054.10.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793980301087
genSpot = 4054.10

plot(showLevels ? 4104.40 : na, "New PUT 4104", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4097.53 : na, "Funds buy (est.) 4098", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4049.67 : na, "New PUT 4050", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4038.72 : na, "New PUT 4039", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3994.94 : na, "New PUT 3995", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4022.60 : na, "Gamma Flip 4023", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4041.22 : na, "VWAP week 4041", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4031.98 : na, "VWAP month 4032", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4050.21 : na, "Week POC 4050", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4104.40, "New PUT  4,104.40  #2  C 20.3K / P 15.4K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4097.53, "Funds buy (est.)  4,097.53", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff9ec7, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4049.67, "New PUT + Week POC  4,049.67  #3  C 13.0K / P 22.6K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4038.72, "New PUT + VWAP week  4,038.72  #6  C 2.6K / P 8.0K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4031.98, "VWAP month  4,031.98", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#4fe0d0, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4022.60, "Gamma Flip  4,022.60", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3994.94, "New PUT  3,994.94  #4  C 9.4K / P 18.7K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-06 22:51 (UTC+7)" + ("\nOnly 2 fresh reading(s) so far: strike levels can still shift by about $10 between runs. Run it 2-3 more times, 10-15 minutes apart, to steady them. VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
