//@version=6
// Generated by gld_levels.py at 2026-11-10 23:03 (UTC+7), gold spot 4044.70.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1794326583076
genSpot = 4044.70

plot(showLevels ? 4097.73 : na, "New PUT 4098", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4094.57 : na, "Funds buy (est.) 4095", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4043.10 : na, "New PUT 4043", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3988.47 : na, "New CALL + New PUT 3988", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4042.36 : na, "Gamma Flip 4042", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4100.57 : na, "VWAP week 4101", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4048.19 : na, "VWAP month 4048", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4073.25 : na, "Month POC 4073", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4097.73, "New PUT + VWAP week + Funds buy (est.)  4,097.73  #3  C 18.1K / P 14.9K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4073.25, "Month POC  4,073.25", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4043.10, "New PUT + Gamma Flip + VWAP month  4,043.10  #2  C 10.1K / P 27.8K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3988.47, "New PUT + New CALL  3,988.47  #5  C 7.0K / P 16.7K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-10 23:03 (UTC+7)" + ("\nOnly 2 fresh reading(s) so far: strike levels can still shift by about $10 between runs. Run it 2-3 more times, 10-15 minutes apart, to steady them. VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
