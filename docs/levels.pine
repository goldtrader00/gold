//@version=6
// Generated by gld_levels.py at 2026-11-06 21:09 (UTC+7), gold spot 4037.80.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793974179608
genSpot = 4037.80

plot(showLevels ? 4097.32 : na, "Funds buy (est.) 4097", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4091.18 : na, "New PUT 4091", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4036.62 : na, "New PUT 4037", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4025.72 : na, "New PUT 4026", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3982.07 : na, "New PUT 3982", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4011.18 : na, "Gamma Flip 4011", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4040.88 : na, "VWAP week 4041", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4031.40 : na, "VWAP month 4031", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4050.00 : na, "Week POC 4050", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4097.32, "Funds buy (est.)  4,097.32", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff9ec7, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4091.18, "New PUT  4,091.18  #2  C 20.3K / P 15.4K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4050.00, "Week POC  4,050.00", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4036.62, "New PUT + VWAP week  4,036.62  #3  C 13.0K / P 22.6K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4025.72, "New PUT + VWAP month  4,025.72  #6  C 2.6K / P 8.0K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4011.18, "Gamma Flip  4,011.18", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3982.07, "New PUT  3,982.07  #4  C 9.4K / P 18.7K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-06 21:09 (UTC+7)" + ("\nUsing an older saved ratio (the GLD quote is stale): strike levels can be off by $10-20. Run again during US hours (after 20:50 your time). VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
