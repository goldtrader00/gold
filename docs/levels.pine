//@version=6
// Generated by gld_levels.py at 2026-11-09 23:36 (UTC+7), gold spot 4117.50.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1794242198358
genSpot = 4117.50

plot(showLevels ? 4145.14 : na, "New CALL 4145", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4096.96 : na, "Funds buy (est.) 4097", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4090.60 : na, "New CALL 4091", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4145.13 : na, "Max Pain 4145", color=#f5c542, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4110.53 : na, "VWAP week 4111", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4121.64 : na, "Week POC 4122", color=#ffa94d, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4075.64 : na, "Month POC 4076", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4145.14, "New CALL + Max Pain  4,145.14  #1  C 46.1K / P 31.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4121.64, "Week POC  4,121.64", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4110.53, "VWAP week  4,110.53", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#6fd0ff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4096.96, "Funds buy (est.)  4,096.96", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff9ec7, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4090.60, "New CALL  4,090.60  #5  C 19.3K / P 14.7K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4075.64, "Month POC  4,075.64", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-09 23:36 (UTC+7)" + ("\nOnly 2 fresh reading(s) so far: strike levels can still shift by about $10 between runs. Run it 2-3 more times, 10-15 minutes apart, to steady them. VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
