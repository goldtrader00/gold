//@version=6
// Generated by gld_levels.py at 2026-10-29 01:23 (UTC+7), gold spot 4034.90.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793211819556
genSpot = 4034.90

plot(showLevels ? 4083.18 : na, "Funds buy (est.) 4083", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4040.12 : na, "New CALL 4040", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4031.26 : na, "Funds buy (est.) 4031", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4088.73 : na, "Gamma Flip 4089", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4035.68 : na, "VWAP week 4036", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4027.86 : na, "Week POC 4028", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4088.73, "Gamma Flip + Funds buy (est.)  4,088.73", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4040.12, "New CALL + VWAP week  4,040.12  #4  C 5.4K / P 12.1K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4027.86, "Week POC + Funds buy (est.)  4,027.86", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-29 01:23 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
