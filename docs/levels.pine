//@version=6
// Generated by gld_levels.py at 2026-10-23 00:51 (UTC+7), gold spot 4046.40.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1792691495232
genSpot = 4046.40

plot(showLevels ? 4093.54 : na, "New PUT 4094", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4038.96 : na, "New PUT 4039", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4023.90 : na, "Funds buy (est.) 4024", color=#ff9ec7, linewidth=1, style=plot.style_linebr)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4093.54, "New PUT  4,093.54  #3  C 8.2K / P 11.7K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4038.96, "New PUT  4,038.96  #5  C 1.1K / P 11.8K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4023.90, "Funds buy (est.)  4,023.90", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff9ec7, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-23 00:51 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
