//@version=6
// Generated by gld_levels.py at 2026-11-11 19:50 (UTC+7), gold spot 4044.00.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1794401437014
genSpot = 4044.00

plot(showLevels ? 4096.23 : na, "Funds buy (est.) 4096", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4094.18 : na, "New CALL 4094", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4039.59 : na, "New CALL + New PUT 4040", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4028.67 : na, "New CALL 4029", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3985.00 : na, "New PUT 3985", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4040.42 : na, "Gamma Flip 4040", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4090.44 : na, "VWAP week 4090", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4049.66 : na, "VWAP month 4050", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4074.91 : na, "Month POC 4075", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4094.18, "New CALL + VWAP week + Funds buy (est.)  4,094.18  #3  C 19.6K / P 14.5K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4074.91, "Month POC  4,074.91", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4049.66, "VWAP month  4,049.66", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#4fe0d0, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4039.59, "New CALL + New PUT + Gamma Flip  4,039.59  #2  C 12.3K / P 30.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4028.67, "New CALL  4,028.67  #6  C 1.6K / P 7.4K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3985.00, "New PUT  3,985.00  #5  C 7.0K / P 17.7K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-11 19:50 (UTC+7)" + ("\nUsing an older saved ratio (the GLD quote is stale): strike levels can be off by $10-20. Run again during US hours (after 20:50 your time). VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
