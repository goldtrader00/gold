//@version=6
// Generated by gld_levels.py at 2026-11-07 00:45 (UTC+7), gold spot 4056.60.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793987153164
genSpot = 4056.60

plot(showLevels ? 4097.59 : na, "New PUT 4098", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4093.72 : na, "Funds buy (est.) 4094", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4042.95 : na, "New PUT 4043", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4032.02 : na, "New PUT 4032", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4029.06 : na, "Gamma Flip 4029", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4037.92 : na, "VWAP week 4038", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4028.84 : na, "VWAP month 4029", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4046.40 : na, "Week POC 4046", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4097.59, "New PUT + Funds buy (est.)  4,097.59  #3  C 20.3K / P 15.4K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4046.40, "Week POC  4,046.40", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4042.95, "New PUT + VWAP week  4,042.95  #4  C 13.0K / P 22.6K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4032.02, "New PUT + Gamma Flip + VWAP month  4,032.02  #7  C 2.6K / P 8.0K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-07 00:45 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
