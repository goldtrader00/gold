//@version=6
// Generated by gld_levels.py at 2026-11-04 01:01 (UTC+7), gold spot 3933.20.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793728918255
genSpot = 3933.20

plot(showLevels ? 3984.28 : na, "New CALL 3984", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3929.70 : na, "New PUT 3930", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3875.12 : na, "New PUT 3875", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 3930.65 : na, "VWAP week 3931", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 3922.14 : na, "VWAP month 3922", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 3905.78 : na, "Week POC 3906", color=#ffa94d, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 3891.78 : na, "Month POC 3892", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 3984.28, "New CALL  3,984.28  #3  C 8.8K / P 20.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3929.70, "New PUT + VWAP week  3,929.70  #4  C 4.1K / P 21.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3922.14, "VWAP month  3,922.14", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#4fe0d0, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3905.78, "Week POC  3,905.78", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3891.78, "Month POC  3,891.78", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3875.12, "New PUT  3,875.12  #5  C 1.6K / P 23.3K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-04 01:01 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
