//@version=6
// Generated by gld_levels.py at 2026-11-12 04:59 (UTC+7), gold spot 3988.80.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1794434356340
genSpot = 3988.80

plot(showLevels ? 4038.92 : na, "New CALL + New PUT 4039", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3984.34 : na, "New PUT 3984", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3929.76 : na, "New PUT 3930", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4036.24 : na, "Gamma Flip 4036", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4043.14 : na, "VWAP month 4043", color=#4fe0d0, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4043.14, "VWAP month  4,043.14", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#4fe0d0, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4038.92, "New PUT + New CALL + Gamma Flip  4,038.92  #1  C 11.8K / P 29.1K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3984.34, "New PUT  3,984.34  #5  C 6.9K / P 17.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3929.76, "New PUT  3,929.76  #3  C 3.4K / P 24.6K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-12 04:59 (UTC+7)" + ("\nUsing an older saved ratio (the GLD quote is stale): strike levels can be off by $10-20. Run again during US hours (after 20:50 your time). VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
