//@version=6
// Generated by gld_levels.py at 2026-10-27 01:42 (UTC+7), gold spot 4015.90.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793040157352
genSpot = 4015.90

plot(showLevels ? 4073.36 : na, "Funds buy (est.) 4073", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4038.29 : na, "New CALL 4038", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4021.43 : na, "Funds buy (est.) 4021", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4016.47 : na, "New CALL 4016", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3983.72 : na, "New CALL + New PUT 3984", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4011.34 : na, "VWAP week 4011", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4018.04 : na, "Week POC 4018", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4073.36, "Funds buy (est.)  4,073.36", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff9ec7, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4038.29, "New CALL  4,038.29  #5  C 7.9K / P 12.0K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4018.04, "Week POC + Funds buy (est.)  4,018.04", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4016.47, "New CALL + VWAP week  4,016.47  #7  C 3.6K / P 6.4K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3983.72, "New CALL + New PUT  3,983.72  #3  C 2.9K / P 20.0K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-27 01:42 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
