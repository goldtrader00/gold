//@version=6
// Generated by gld_levels.py at 2026-11-07 01:48 (UTC+7), gold spot 4073.50.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793990881298
genSpot = 4073.50

plot(showLevels ? 4099.84 : na, "New PUT 4100", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4094.93 : na, "Funds buy (est.) 4095", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4045.18 : na, "New PUT 4045", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4034.24 : na, "New PUT 4034", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4035.84 : na, "Gamma Flip 4036", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4039.29 : na, "VWAP week 4039", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4030.27 : na, "VWAP month 4030", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4047.61 : na, "Week POC 4048", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4099.84, "New PUT + Funds buy (est.)  4,099.84  #3  C 20.3K / P 15.4K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4047.61, "Week POC  4,047.61", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4045.18, "New PUT + VWAP week  4,045.18  #4  C 13.0K / P 22.6K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4034.24, "New PUT + Gamma Flip + VWAP month  4,034.24  #7  C 2.6K / P 8.0K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-07 01:48 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
