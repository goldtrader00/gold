//@version=6
// Generated by gld_levels.py at 2026-10-28 20:55 (UTC+7), gold spot 4051.80.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793195723324
genSpot = 4051.80

plot(showLevels ? 4084.44 : na, "Funds buy (est.) 4084", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4043.07 : na, "New CALL 4043", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4032.51 : na, "Funds buy (est.) 4033", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4090.98 : na, "Gamma Flip 4091", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4036.54 : na, "VWAP week 4037", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4029.12 : na, "Week POC 4029", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4090.98, "Gamma Flip  4,090.98", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4084.44, "Funds buy (est.)  4,084.44", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff9ec7, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4043.07, "New CALL  4,043.07  #4  C 5.4K / P 12.1K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4036.54, "VWAP week  4,036.54", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#6fd0ff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4029.12, "Week POC + Funds buy (est.)  4,029.12", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-28 20:55 (UTC+7)" + ("\nOnly 1 fresh reading(s) so far: strike levels can still shift by about $10 between runs. Run it 2-3 more times, 10-15 minutes apart, to steady them. VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
