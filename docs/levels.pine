//@version=6
// Generated by gld_levels.py at 2026-11-05 01:02 (UTC+7), gold spot 4069.10.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793815375422
genSpot = 4069.10

plot(showLevels ? 4127.29 : na, "New CALL 4127", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4094.53 : na, "New CALL 4095", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4090.69 : na, "Funds buy (est.) 4091", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4039.94 : na, "New CALL 4040", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4029.02 : na, "New CALL 4029", color=#2ecc71, linewidth=1, style=plot.style_linebr)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4127.29, "New CALL  4,127.29  #8  C 6.6K / P 892", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4094.53, "New CALL + Funds buy (est.)  4,094.53  #3  C 18.2K / P 14.6K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4039.94, "New CALL  4,039.94  #2  C 15.6K / P 20.8K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4029.02, "New CALL  4,029.02  #7  C 3.6K / P 6.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-05 01:02 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
