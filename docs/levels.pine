//@version=6
// Generated by gld_levels.py at 2026-10-24 03:33 (UTC+7), gold spot 3996.70.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1792787621026
genSpot = 3996.70

plot(showLevels ? 4039.44 : na, "New CALL + New PUT 4039", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4023.15 : na, "Funds buy (est.) 4023", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4017.60 : na, "New CALL + New PUT 4018", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3984.85 : na, "New PUT 3985", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4028.75 : na, "Week POC 4029", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4039.44, "New PUT + New CALL  4,039.44  #5  C 2.5K / P 12.0K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4028.75, "Week POC  4,028.75", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4017.60, "New PUT + New CALL + Funds buy (est.)  4,017.60  #7  C 2.7K / P 6.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3984.85, "New PUT  3,984.85  #6  C 655 / P 12.8K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-24 03:33 (UTC+7)" + ("\nUsing an older saved ratio (the GLD quote is stale): strike levels can be off by $10-20. Run again during US hours (after 20:50 your time). VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
