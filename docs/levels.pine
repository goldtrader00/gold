//@version=6
// Generated by gld_levels.py at 2026-10-19 21:01 (UTC+7), gold spot 4154.10.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1792418502816
genSpot = 4154.10

plot(showLevels ? 4201.32 : na, "New CALL 4201", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4146.75 : na, "New PUT 4147", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4158.33 : na, "Gamma Flip 4158", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4135.84 : na, "Max Pain 4136", color=#f5c542, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4172.37 : na, "VWAP week 4172", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4165.15 : na, "VWAP month 4165", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4171.82 : na, "Week POC 4172", color=#ffa94d, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4192.82 : na, "Month POC 4193", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4201.32, "New CALL  4,201.32  #5  C 8.8K / P 3.4K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4192.82, "Month POC  4,192.82", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4171.82, "Week POC + VWAP week  4,171.82", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4165.15, "VWAP month  4,165.15", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#4fe0d0, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4158.33, "Gamma Flip  4,158.33", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4146.75, "New PUT  4,146.75  #2  C 14.8K / P 18.1K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4135.84, "Max Pain  4,135.84", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#f5c542, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-19 21:01 (UTC+7)" + ("\nOnly 1 fresh reading(s) so far: strike levels can still shift by about $10 between runs. Run it 2-3 more times, 10-15 minutes apart, to steady them. VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
