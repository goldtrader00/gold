//@version=6
// Generated by gld_levels.py at 2026-10-22 19:26 (UTC+7), gold spot 4071.30.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1792672006094
genSpot = 4071.30

plot(showLevels ? 4093.35 : na, "New PUT 4093", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4038.77 : na, "New PUT 4039", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4027.12 : na, "Funds buy (est.) 4027", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4128.50 : na, "VWAP week 4128", color=#6fd0ff, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4128.50, "VWAP week  4,128.50", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#6fd0ff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4093.35, "New PUT  4,093.35  #3  C 8.2K / P 11.7K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4038.77, "New PUT  4,038.77  #6  C 1.1K / P 11.8K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4027.12, "Funds buy (est.)  4,027.12", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff9ec7, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-22 19:26 (UTC+7)" + ("\nUsing an older saved ratio (the GLD quote is stale): strike levels can be off by $10-20. Run again during US hours (after 20:50 your time). VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
