//@version=6
// Generated by gld_levels.py at 2026-10-27 03:08 (UTC+7), gold spot 4013.40.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793045291299
genSpot = 4013.40

plot(showLevels ? 4037.85 : na, "New CALL 4038", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4021.88 : na, "Funds buy (est.) 4022", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4016.02 : na, "New CALL 4016", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3983.28 : na, "New CALL + New PUT 3983", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4011.83 : na, "VWAP week 4012", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4018.48 : na, "Week POC 4018", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4037.85, "New CALL  4,037.85  #6  C 3.9K / P 10.1K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4018.48, "Week POC + Funds buy (est.)  4,018.48", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4016.02, "New CALL + VWAP week  4,016.02  #7  C 3.4K / P 6.3K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3983.28, "New CALL + New PUT  3,983.28  #3  C 2.6K / P 18.8K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-27 03:08 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
