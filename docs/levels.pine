//@version=6
// Generated by gld_levels.py at 2026-11-09 22:26 (UTC+7), gold spot 4117.90.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1794238008034
genSpot = 4117.90

plot(showLevels ? 4149.68 : na, "Call Wall + New CALL 4150", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4098.09 : na, "Funds buy (est.) 4098", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4095.07 : na, "New CALL 4095", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4149.68 : na, "Max Pain 4150", color=#f5c542, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4111.26 : na, "VWAP week 4111", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4124.77 : na, "Week POC 4125", color=#ffa94d, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4076.77 : na, "Month POC 4077", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4149.68, "Call Wall + New CALL + Max Pain  4,149.68  #1  C 46.1K / P 31.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4124.77, "Week POC  4,124.77", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4111.26, "VWAP week  4,111.26", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#6fd0ff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4095.07, "New CALL + Funds buy (est.)  4,095.07  #5  C 19.3K / P 14.7K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4076.77, "Month POC  4,076.77", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-09 22:26 (UTC+7)" + ("\nOnly 1 fresh reading(s) so far: strike levels can still shift by about $10 between runs. Run it 2-3 more times, 10-15 minutes apart, to steady them. VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
