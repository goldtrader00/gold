//@version=6
// Generated by gld_levels.py at 2026-11-03 05:15 (UTC+7), gold spot 3947.70.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793657748239
genSpot = 3947.70

plot(showLevels ? 3985.00 : na, "New CALL 3985", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3930.41 : na, "New CALL + New PUT 3930", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 3932.04 : na, "VWAP week 3932", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 3920.60 : na, "VWAP month 3921", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 3907.92 : na, "Week POC 3908", color=#ffa94d, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 3893.92 : na, "Month POC 3894", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 3985.00, "New CALL  3,985.00  #3  C 5.7K / P 15.9K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3930.41, "New CALL + New PUT + VWAP week  3,930.41  #5  C 3.2K / P 15.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3920.60, "VWAP month  3,920.60", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#4fe0d0, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3907.92, "Week POC  3,907.92", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3893.92, "Month POC  3,893.92", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-03 05:15 (UTC+7)" + ("\nUsing an older saved ratio (the GLD quote is stale): strike levels can be off by $10-20. Run again during US hours (after 20:50 your time). VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
