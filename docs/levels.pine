//@version=6
// Generated by gld_levels.py at 2026-11-03 02:26 (UTC+7), gold spot 3948.70.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793647611675
genSpot = 3948.70

plot(showLevels ? 3980.78 : na, "New CALL 3981", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3926.25 : na, "New CALL + New PUT 3926", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 3897.12 : na, "Gamma Flip 3897", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 3934.32 : na, "VWAP week 3934", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 3922.66 : na, "VWAP month 3923", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 3911.20 : na, "Week POC 3911", color=#ffa94d, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 3897.20 : na, "Month POC 3897", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 3980.78, "New CALL  3,980.78  #2  C 6.5K / P 17.1K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3934.32, "VWAP week  3,934.32", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#6fd0ff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3926.25, "New CALL + New PUT + VWAP month  3,926.25  #5  C 4.1K / P 16.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3911.20, "Week POC  3,911.20", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3897.12, "Gamma Flip + Month POC  3,897.12", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-03 02:26 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
