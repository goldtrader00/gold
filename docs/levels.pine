//@version=6
// Generated by gld_levels.py at 2026-10-21 02:33 (UTC+7), gold spot 4123.00.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1792524822255
genSpot = 4123.00

plot(showLevels ? 4147.85 : na, "New CALL + New PUT 4148", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4093.27 : na, "New PUT 4093", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4153.53 : na, "Gamma Flip 4154", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4147.42 : na, "VWAP week 4147", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4155.66 : na, "VWAP month 4156", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4140.46 : na, "Week POC 4140", color=#ffa94d, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4140.46 : na, "Month POC 4140", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4153.53, "Gamma Flip + VWAP month  4,153.53", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4147.85, "New CALL + New PUT + VWAP week  4,147.85  #2  C 15.7K / P 18.1K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4140.46, "Month POC + Week POC  4,140.46", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4093.27, "New PUT  4,093.27  #3  C 8.2K / P 11.1K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-21 02:33 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
