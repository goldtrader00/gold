//@version=6
// Generated by gld_levels.py at 2026-11-10 19:49 (UTC+7), gold spot 4077.40.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1794314941875
genSpot = 4077.40

plot(showLevels ? 4128.21 : na, "New CALL + New PUT 4128", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4095.45 : na, "New PUT 4095", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4094.17 : na, "Funds buy (est.) 4094", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4040.84 : na, "Put Wall + New PUT 4041", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4047.12 : na, "Gamma Flip 4047", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4110.08 : na, "VWAP week 4110", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4047.62 : na, "VWAP month 4048", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4115.85 : na, "Week POC 4116", color=#ffa94d, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4072.85 : na, "Month POC 4073", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4128.21, "New CALL + New PUT  4,128.21  #8  C 6.0K / P 2.0K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4110.08, "Week POC + VWAP week  4,110.08", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#6fd0ff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4095.45, "New PUT + Funds buy (est.)  4,095.45  #4  C 18.1K / P 14.9K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4072.85, "Month POC  4,072.85", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4047.12, "Gamma Flip + VWAP month  4,047.12", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4040.84, "Put Wall + New PUT  4,040.84  #2  C 10.1K / P 27.8K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-10 19:49 (UTC+7)" + ("\nUsing an older saved ratio (the GLD quote is stale): strike levels can be off by $10-20. Run again during US hours (after 20:50 your time). VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
