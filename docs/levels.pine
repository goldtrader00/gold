//@version=6
// Generated by gld_levels.py at 2026-10-29 23:49 (UTC+7), gold spot 4018.10.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793292585721
genSpot = 4018.10

plot(showLevels ? 4038.83 : na, "New PUT 4039", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4028.05 : na, "Funds buy (est.) 4028", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3984.25 : na, "New PUT 3984", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4070.31 : na, "Gamma Flip 4070", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4033.52 : na, "VWAP week 4034", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4022.65 : na, "Week POC 4023", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4070.31, "Gamma Flip  4,070.31", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4038.83, "New PUT + VWAP week  4,038.83  #5  C 4.9K / P 15.6K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4022.65, "Week POC + Funds buy (est.)  4,022.65", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3984.25, "New PUT  3,984.25  #4  C 2.9K / P 18.6K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-29 23:49 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
