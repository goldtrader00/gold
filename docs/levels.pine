//@version=6
// Generated by gld_levels.py at 2026-10-27 22:43 (UTC+7), gold spot 4064.50.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793115813856
genSpot = 4064.50

plot(showLevels ? 4096.95 : na, "New CALL 4097", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4083.03 : na, "Funds buy (est.) 4083", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4042.32 : na, "New CALL + New PUT 4042", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4031.11 : na, "Funds buy (est.) 4031", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4020.48 : na, "New CALL 4020", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4103.18 : na, "Gamma Flip 4103", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4026.99 : na, "VWAP week 4027", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4027.71 : na, "Week POC 4028", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4103.18, "Gamma Flip  4,103.18", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4096.95, "New CALL  4,096.95  #3  C 12.2K / P 9.1K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4083.03, "Funds buy (est.)  4,083.03", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff9ec7, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4042.32, "New PUT + New CALL  4,042.32  #5  C 5.9K / P 12.0K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4026.99, "VWAP week + Week POC + Funds buy (est.)  4,026.99", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#6fd0ff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4020.48, "New CALL  4,020.48  #7  C 4.0K / P 6.8K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-27 22:43 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
