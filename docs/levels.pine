//@version=6
// Generated by gld_levels.py at 2026-11-12 02:15 (UTC+7), gold spot 3987.40.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1794424547206
genSpot = 3987.40

plot(showLevels ? 4038.92 : na, "New CALL + New PUT 4039", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4028.01 : na, "New CALL 4028", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3984.34 : na, "New PUT 3984", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3929.76 : na, "New PUT 3930", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4021.49 : na, "Gamma Flip 4021", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4043.11 : na, "VWAP month 4043", color=#4fe0d0, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4038.92, "New PUT + New CALL + VWAP month  4,038.92  #1  C 12.3K / P 30.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4028.01, "New CALL  4,028.01  #6  C 1.6K / P 7.4K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4021.49, "Gamma Flip  4,021.49", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3984.34, "New PUT  3,984.34  #5  C 7.0K / P 17.7K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3929.76, "New PUT  3,929.76  #3  C 3.4K / P 25.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-12 02:15 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
