//@version=6
// Generated by gld_levels.py at 2026-10-21 21:31 (UTC+7), gold spot 4136.20.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1792593117422
genSpot = 4136.20

plot(showLevels ? 4149.96 : na, "New CALL 4150", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4095.36 : na, "New PUT 4095", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4141.93 : na, "Gamma Flip 4142", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4144.23 : na, "VWAP week 4144", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4156.47 : na, "VWAP month 4156", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4142.12 : na, "Week POC 4142", color=#ffa94d, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4142.12 : na, "Month POC 4142", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4156.47, "VWAP month  4,156.47", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#4fe0d0, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4149.96, "New CALL  4,149.96  #2  C 17.3K / P 18.0K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4141.93, "Gamma Flip + Month POC + Week POC + VWAP week  4,141.93", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4095.36, "New PUT  4,095.36  #3  C 8.3K / P 10.1K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-21 21:31 (UTC+7)" + ("\nOnly 2 fresh reading(s) so far: strike levels can still shift by about $10 between runs. Run it 2-3 more times, 10-15 minutes apart, to steady them. VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
