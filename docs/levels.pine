//@version=6
// Generated by gld_levels.py at 2026-11-06 05:19 (UTC+7), gold spot 4089.20.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793917183494
genSpot = 4089.20

plot(showLevels ? 4145.73 : na, "Call Wall + New CALL 4146", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4091.18 : na, "New CALL 4091", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4088.55 : na, "Funds buy (est.) 4089", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4036.62 : na, "New PUT 4037", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4145.72 : na, "Max Pain 4146", color=#f5c542, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4145.73, "Call Wall + New CALL + Max Pain  4,145.73  #1  C 47.1K / P 31.7K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4091.18, "New CALL + Funds buy (est.)  4,091.18  #3  C 20.5K / P 14.6K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4036.62, "New PUT  4,036.62  #2  C 14.2K / P 21.6K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-06 05:19 (UTC+7)" + ("\nUsing an older saved ratio (the GLD quote is stale): strike levels can be off by $10-20. Run again during US hours (after 20:50 your time). VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
