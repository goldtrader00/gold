//@version=6
// Generated by gld_levels.py at 2026-10-19 09:31 (UTC+7), gold spot 4167.01.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1792377102140
genSpot = 4167.01

plot(showLevels ? 4134.40 : na, "Put Wall 4134", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4148.29 : na, "Gamma Flip 4148", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4170.13 : na, "VWAP week 4170", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4161.69 : na, "VWAP month 4162", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4170.50 : na, "Week POC 4170", color=#ffa94d, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4189.50 : na, "Month POC 4190", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4189.50, "Month POC  4,189.50", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4170.13, "Week POC + VWAP week  4,170.13", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#6fd0ff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4161.69, "VWAP month  4,161.69", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#4fe0d0, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4148.29, "Gamma Flip  4,148.29", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4134.40, "Put Wall  4,134.40  #2  C 14.8K / P 16.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-19 09:31 (UTC+7)" + ("\nNo fresh price ratio yet: strike levels (ceilings, floors, flip, max pain) can be off by $10-50. Run again during US hours (after 20:50 your time). VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
