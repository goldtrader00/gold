//@version=6
// Generated by gld_levels.py at 2026-10-26 22:10 (UTC+7), gold spot 4022.90.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793027434829
genSpot = 4022.90

plot(showLevels ? 4071.61 : na, "Funds buy (est.) 4072", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4041.14 : na, "New CALL 4041", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4019.69 : na, "Funds buy (est.) 4020", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4019.30 : na, "New CALL 4019", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3986.53 : na, "New CALL + New PUT 3987", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4007.23 : na, "VWAP week 4007", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4014.29 : na, "Week POC 4014", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4071.61, "Funds buy (est.)  4,071.61", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff9ec7, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4041.14, "New CALL  4,041.14  #5  C 7.9K / P 12.0K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4019.30, "New CALL + Week POC + Funds buy (est.)  4,019.30  #7  C 3.6K / P 6.4K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4007.23, "VWAP week  4,007.23", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#6fd0ff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3986.53, "New PUT + New CALL  3,986.53  #3  C 2.9K / P 20.0K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-26 22:10 (UTC+7)" + ("\nOnly 2 fresh reading(s) so far: strike levels can still shift by about $10 between runs. Run it 2-3 more times, 10-15 minutes apart, to steady them. VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
