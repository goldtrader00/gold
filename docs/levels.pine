//@version=6
// Generated by gld_levels.py at 2026-11-02 19:47 (UTC+7), gold spot 3901.70.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793623669361
genSpot = 3901.70

plot(showLevels ? 3927.42 : na, "New CALL + New PUT 3927", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3872.88 : na, "New CALL + New PUT 3873", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 3905.32 : na, "VWAP week 3905", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 3897.77 : na, "VWAP month 3898", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 3901.97 : na, "Week POC 3902", color=#ffa94d, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 3887.97 : na, "Month POC 3888", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 3927.42, "New CALL + New PUT  3,927.42  #6  C 4.1K / P 16.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3905.32, "VWAP week  3,905.32", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#6fd0ff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3897.77, "Week POC + VWAP month  3,897.77", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#4fe0d0, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3887.97, "Month POC  3,887.97", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3872.88, "New CALL + New PUT  3,872.88  #4  C 1.8K / P 21.0K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-02 19:47 (UTC+7)" + ("\nUsing an older saved ratio (the GLD quote is stale): strike levels can be off by $10-20. Run again during US hours (after 20:50 your time). VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
