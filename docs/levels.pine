//@version=6
// Generated by gld_levels.py at 2026-10-28 03:34 (UTC+7), gold spot 4060.20.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793133265823
genSpot = 4060.20

plot(showLevels ? 4095.79 : na, "New CALL 4096", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4083.15 : na, "Funds buy (est.) 4083", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4041.18 : na, "New CALL + New PUT 4041", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4031.23 : na, "Funds buy (est.) 4031", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4113.10 : na, "Gamma Flip 4113", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4031.30 : na, "VWAP week 4031", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4027.83 : na, "Week POC 4028", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4113.10, "Gamma Flip  4,113.10", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4095.79, "New CALL  4,095.79  #3  C 11.8K / P 8.9K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4083.15, "Funds buy (est.)  4,083.15", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff9ec7, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4041.18, "New CALL + New PUT  4,041.18  #5  C 4.7K / P 11.7K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4027.83, "Week POC + VWAP week + Funds buy (est.)  4,027.83", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-28 03:34 (UTC+7)" + ("\nUsing an older saved ratio (the GLD quote is stale): strike levels can be off by $10-20. Run again during US hours (after 20:50 your time). VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
