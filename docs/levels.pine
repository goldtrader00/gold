//@version=6
// Generated by gld_levels.py at 2026-11-11 22:10 (UTC+7), gold spot 4009.04.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1794409822124
genSpot = 4009.04

plot(showLevels ? 4065.29 : na, "New CALL 4065", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4032.59 : na, "New CALL + New PUT 4033", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4021.69 : na, "New CALL 4022", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3978.10 : na, "New PUT 3978", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4028.13 : na, "Gamma Flip 4028", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4039.02 : na, "VWAP month 4039", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4064.50 : na, "Month POC 4064", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4065.29, "New CALL + Month POC  4,065.29  #8  C 5.4K / P 1.8K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4039.02, "VWAP month  4,039.02", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#4fe0d0, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4032.59, "New CALL + New PUT + Gamma Flip  4,032.59  #2  C 12.3K / P 30.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4021.69, "New CALL  4,021.69  #7  C 1.6K / P 7.4K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3978.10, "New PUT  3,978.10  #6  C 7.0K / P 17.7K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-11 22:10 (UTC+7)" + ("\nOnly 1 fresh reading(s) so far: strike levels can still shift by about $10 between runs. Run it 2-3 more times, 10-15 minutes apart, to steady them. VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
