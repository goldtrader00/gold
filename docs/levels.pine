//@version=6
// Generated by gld_levels.py at 2026-11-10 22:04 (UTC+7), gold spot 4048.60.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1794323058710
genSpot = 4048.60

plot(showLevels ? 4101.30 : na, "New PUT 4101", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4092.37 : na, "Funds buy (est.) 4092", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4046.61 : na, "New PUT 4047", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3991.93 : na, "New CALL + New PUT 3992", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4045.74 : na, "Gamma Flip 4046", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4099.82 : na, "VWAP week 4100", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4046.01 : na, "VWAP month 4046", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4071.05 : na, "Month POC 4071", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4101.30, "New PUT + VWAP week  4,101.30  #3  C 18.1K / P 14.9K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4092.37, "Funds buy (est.)  4,092.37", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff9ec7, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4071.05, "Month POC  4,071.05", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4046.61, "New PUT + Gamma Flip + VWAP month  4,046.61  #2  C 10.1K / P 27.8K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3991.93, "New CALL + New PUT  3,991.93  #5  C 7.0K / P 16.7K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-10 22:04 (UTC+7)" + ("\nOnly 1 fresh reading(s) so far: strike levels can still shift by about $10 between runs. Run it 2-3 more times, 10-15 minutes apart, to steady them. VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
