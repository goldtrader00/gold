//@version=6
// Generated by gld_levels.py at 2026-11-04 02:10 (UTC+7), gold spot 3928.90.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793733015279
genSpot = 3928.90

plot(showLevels ? 3984.82 : na, "New CALL 3985", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3930.23 : na, "New PUT 3930", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3875.64 : na, "New PUT 3876", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 3931.77 : na, "VWAP week 3932", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 3923.30 : na, "VWAP month 3923", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 3906.90 : na, "Week POC 3907", color=#ffa94d, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 3892.90 : na, "Month POC 3893", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 3984.82, "New CALL  3,984.82  #3  C 8.8K / P 20.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3930.23, "New PUT + VWAP week  3,930.23  #4  C 4.1K / P 21.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3923.30, "VWAP month  3,923.30", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#4fe0d0, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3906.90, "Week POC  3,906.90", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3892.90, "Month POC  3,892.90", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3875.64, "New PUT  3,875.64  #5  C 1.6K / P 23.3K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-04 02:10 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
