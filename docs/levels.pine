//@version=6
// Generated by gld_levels.py at 2026-11-07 05:14 (UTC+7), gold spot 4072.10.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1794003264014
genSpot = 4072.10

plot(showLevels ? 4129.43 : na, "New CALL 4129", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4096.65 : na, "New PUT 4097", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4095.61 : na, "Funds buy (est.) 4096", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4042.03 : na, "New PUT 4042", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4031.11 : na, "New PUT 4031", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4019.97 : na, "Gamma Flip 4020", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4040.42 : na, "VWAP week 4040", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4031.49 : na, "VWAP month 4031", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4048.29 : na, "Week POC 4048", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4129.43, "New CALL  4,129.43  #8  C 5.2K / P 1.2K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4096.65, "New PUT + Funds buy (est.)  4,096.65  #4  C 18.0K / P 14.5K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4048.29, "Week POC  4,048.29", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4042.03, "New PUT + VWAP week  4,042.03  #3  C 11.2K / P 21.5K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4031.11, "New PUT + VWAP month  4,031.11  #7  C 1.3K / P 7.4K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4019.97, "Gamma Flip  4,019.97", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-07 05:14 (UTC+7)" + ("\nUsing an older saved ratio (the GLD quote is stale): strike levels can be off by $10-20. Run again during US hours (after 20:50 your time). VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
