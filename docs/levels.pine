//@version=6
// Generated by gld_levels.py at 2026-11-06 22:00 (UTC+7), gold spot 4050.40.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793977224158
genSpot = 4050.40

plot(showLevels ? 4107.90 : na, "New PUT 4108", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4095.40 : na, "Funds buy (est.) 4095", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4053.13 : na, "New PUT 4053", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4042.18 : na, "New PUT 4042", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 3998.36 : na, "New PUT 3998", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4024.96 : na, "Gamma Flip 4025", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4038.99 : na, "VWAP week 4039", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4029.68 : na, "VWAP month 4030", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4048.08 : na, "Week POC 4048", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4107.90, "New PUT  4,107.90  #2  C 20.3K / P 15.4K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4095.40, "Funds buy (est.)  4,095.40", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff9ec7, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4053.13, "New PUT + Week POC  4,053.13  #3  C 13.0K / P 22.6K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4042.18, "New PUT + VWAP week  4,042.18  #6  C 2.6K / P 8.0K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4024.96, "Gamma Flip + VWAP month  4,024.96", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 3998.36, "New PUT  3,998.36  #4  C 9.4K / P 18.7K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-06 22:00 (UTC+7)" + ("\nOnly 1 fresh reading(s) so far: strike levels can still shift by about $10 between runs. Run it 2-3 more times, 10-15 minutes apart, to steady them. VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
