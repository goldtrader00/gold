//@version=6
// Generated by gld_levels.py at 2026-10-27 23:30 (UTC+7), gold spot 4058.40.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793118649789
genSpot = 4058.40

plot(showLevels ? 4094.87 : na, "New CALL 4095", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4081.06 : na, "Funds buy (est.) 4081", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4040.27 : na, "New CALL + New PUT 4040", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4029.14 : na, "Funds buy (est.) 4029", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4018.43 : na, "New CALL 4018", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4100.65 : na, "Gamma Flip 4101", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4027.05 : na, "VWAP week 4027", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4025.74 : na, "Week POC 4026", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4094.87, "New CALL + Gamma Flip  4,094.87  #3  C 12.2K / P 9.1K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4081.06, "Funds buy (est.)  4,081.06", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff9ec7, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4040.27, "New CALL + New PUT  4,040.27  #5  C 5.9K / P 12.0K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4025.74, "VWAP week + Week POC + Funds buy (est.)  4,025.74", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4018.43, "New CALL  4,018.43  #7  C 4.0K / P 6.8K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-27 23:30 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
