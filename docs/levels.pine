//@version=6
// Generated by gld_levels.py at 2026-11-06 23:48 (UTC+7), gold spot 4064.00.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1793983706716
genSpot = 4064.00

plot(showLevels ? 4100.89 : na, "New PUT 4101", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4096.89 : na, "Funds buy (est.) 4097", color=#ff9ec7, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4046.21 : na, "New PUT 4046", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4035.27 : na, "New PUT 4035", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4025.41 : na, "Gamma Flip 4025", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4040.85 : na, "VWAP week 4041", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4031.69 : na, "VWAP month 4032", color=#4fe0d0, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4049.57 : na, "Week POC 4050", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4100.89, "New PUT + Funds buy (est.)  4,100.89  #3  C 20.3K / P 15.4K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4049.57, "Week POC  4,049.57", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4046.21, "New PUT + VWAP week  4,046.21  #4  C 13.0K / P 22.6K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4035.27, "New PUT + VWAP month  4,035.27  #7  C 2.6K / P 8.0K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4025.41, "Gamma Flip  4,025.41", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-11-06 23:48 (UTC+7)" + ("")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
