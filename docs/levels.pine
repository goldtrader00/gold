//@version=6
// Generated by gld_levels.py at 2026-10-20 04:28 (UTC+7), gold spot 4141.90.
// Paste into TradingView > Pine Editor > Save > Add to chart. Use on OANDA:XAUUSD.
// Levels are static: run the script again and paste the new version to refresh them.
indicator("GLD Options Levels", overlay=true, max_labels_count=60)

showLevels  = input.bool(true, "Show option levels (solid lines)")
showMarkers = input.bool(true, "Show flip / max pain / VWAP (dotted lines)")
showLabels  = input.bool(true, "Show labels")
labelOff    = input.int(4, "Label offset (bars to the right)", minval=0, maxval=100)
staleHours  = input.float(2.0, "Mark as STALE after (hours)", minval=0.1)
moveWarn    = input.float(30.0, "Warn when price moved this many $ since the run", minval=1.0)

genMs   = 1792445303879
genSpot = 4141.90

plot(showLevels ? 4147.51 : na, "New PUT 4148", color=#ff5252, linewidth=1, style=plot.style_linebr)
plot(showLevels ? 4092.94 : na, "New CALL + New PUT 4093", color=#2ecc71, linewidth=1, style=plot.style_linebr)
plot(showMarkers ? 4160.97 : na, "Gamma Flip 4161", color=#b79bff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4147.51 : na, "Max Pain 4148", color=#f5c542, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4160.20 : na, "VWAP W + M 4160", color=#6fd0ff, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4167.30 : na, "Week POC 4167", color=#ffa94d, linewidth=1, style=plot.style_circles)
plot(showMarkers ? 4144.30 : na, "Month POC 4144", color=#ffa94d, linewidth=1, style=plot.style_circles)

var array<label> lbs = array.new<label>()
var table info = table.new(position.top_right, 1, 1)

if barstate.islast
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)
    if showLabels
        array.push(lbs, label.new(bar_index + labelOff, 4167.30, "Week POC  4,167.30", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ffa94d, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4160.97, "Gamma Flip + VWAP W + M  4,160.97", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#b79bff, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4147.51, "New PUT + Max Pain + Month POC  4,147.51  #2  C 14.1K / P 17.4K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#ff5252, size=size.normal))
        array.push(lbs, label.new(bar_index + labelOff, 4092.94, "New CALL + New PUT  4,092.94  #3  C 8.1K / P 10.0K", style=label.style_label_left, color=color.new(#0b0f1a, 10), textcolor=#2ecc71, size=size.normal))
    ageH = (timenow - genMs) / 3600000.0
    moved = close - genSpot
    stale = ageH > staleHours or math.abs(moved) > moveWarn
    msg = ""
    if ageH > staleHours
        msg += "STALE: levels are " + str.tostring(ageH, "#.#") + " h old. Run the script again.\n"
    if math.abs(moved) > moveWarn
        msg += "Price moved " + str.tostring(moved, "#.#") + " since the run.\n"
    msg += "Levels from 2026-10-20 04:28 (UTC+7)" + ("\nUsing an older saved ratio (the GLD quote is stale): strike levels can be off by $10-20. Run again during US hours (after 20:50 your time). VWAPs are not affected.")
    table.cell(info, 0, 0, msg, text_color=color.white, bgcolor=stale ? color.new(color.red, 30) : color.new(color.gray, 60), text_size=size.small)
